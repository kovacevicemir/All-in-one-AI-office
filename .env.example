# AI Office — local environment
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Secrets live ONLY here and in your shell environment. Nothing in this file is
# ever written to the office data directory or returned over the API.

# ---------------------------------------------------------------- DeepSeek --
# API key used by the PI harness for DeepSeek models (deepseek-flash, deepseek-v4-pro).
# Get one at https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------- PI -----
# Executable used as the PI harness. Bare name resolves on PATH.
#PI_COMMAND=pi
# Force PI's project-trust decision for office runs. Unset, the office passes no
# trust flag and PI applies the same decision as an interactive run. Set to true
# or false to force it for unattended runs.
#AI_OFFICE_APPROVE_PROJECT=
# How often the PI adapter polls PI for context usage, in milliseconds.
#AI_OFFICE_TELEMETRY_INTERVAL_MS=2000
# Opt in to the real end-to-end smoke test (skipped by default). Needs a real PI
# install and DEEPSEEK_API_KEY; it makes real model calls and costs tokens.
#AI_OFFICE_REAL_SMOKE=0

# -------------------------------------------------------------- Runtime -----
# Where agents, departments, tasks, and run history are snapshotted.
#AI_OFFICE_DATA_DIR=.ai-office
#AI_OFFICE_HOST=127.0.0.1
#AI_OFFICE_PORT=4317

# --------------------------------------------------- Context pressure -------
# Percent of the model's context window at which a bot starts complaining or
# stressing. Tune per model: a 1M-token model wants very different numbers to a
# 128K one.
#AI_OFFICE_PRESSURE_WARNING=30
#AI_OFFICE_PRESSURE_CRITICAL=50
#AI_OFFICE_PRESSURE_HYSTERESIS=5
